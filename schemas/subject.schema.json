{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PH0MBER investigation input v1",
  "type": "object",
  "required": ["schema_version", "subject"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "first_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "middle_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "surname": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "preferred_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "biography": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "nationality": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "aliases": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "usernames": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "languages": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "websites": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "domains": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "education": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "date": {
                "$ref": "#/definitions/date"
              },
              "sources": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              }
            }
          }
        },
        "projects": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "date": {
                "$ref": "#/definitions/date"
              },
              "sources": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              }
            }
          }
        },
        "connections": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "date": {
                "$ref": "#/definitions/date"
              },
              "sources": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              }
            }
          }
        },
        "achievements": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "date": {
                "$ref": "#/definitions/date"
              },
              "sources": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              }
            }
          }
        },
        "publications": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "date": {
                "$ref": "#/definitions/date"
              },
              "sources": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              }
            }
          }
        },
        "organizations": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "date": {
                "$ref": "#/definitions/date"
              },
              "sources": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              }
            }
          }
        },
        "community": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "date": {
                "$ref": "#/definitions/date"
              },
              "sources": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              }
            }
          }
        },
        "timeline": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "date": {
                "$ref": "#/definitions/date"
              },
              "sources": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              }
            }
          }
        },
        "digital_footprint": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "date": {
                "$ref": "#/definitions/date"
              },
              "sources": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              }
            }
          }
        },
        "professional": {
          "type": "object",
          "properties": {
            "company": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "companies": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "history": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "date": {
                    "$ref": "#/definitions/date"
                  },
                  "sources": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    }
                  }
                }
              }
            }
          },
          "additionalProperties": true
        },
        "socials": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": ["platform"],
            "additionalProperties": false,
            "properties": {
              "platform": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "username": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "anyOf": [
              {
                "required": ["username"]
              },
              {
                "required": ["url"]
              }
            ]
          }
        },
        "custom": {
          "type": "object"
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "depth": {
          "enum": ["quick", "standard", "deep"]
        },
        "offline": {
          "type": "boolean"
        },
        "omit": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    },
    "output": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["html", "json"]
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "category",
          "field",
          "value",
          "url",
          "excerpt",
          "retrieved_at"
        ],
        "additionalProperties": false,
        "properties": {
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "excerpt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "retrieved_at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    }
  },
  "definitions": {
    "date": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
        },
        "end": {
          "type": "string",
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
        },
        "precision": {
          "enum": ["day", "month", "year", "unknown"]
        },
        "uncertain": {
          "type": "boolean"
        }
      }
    }
  }
}
