{
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "created_at",
    "updated_at",
    "status",
    "input",
    "findings",
    "sources",
    "evidence",
    "connections",
    "timeline",
    "plan",
    "warnings",
    "summary",
    "depth"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{5,100}$"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "status": {
      "enum": [
        "running",
        "complete",
        "partial",
        "interrupted"
      ]
    },
    "input": {
      "type": "object"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "field",
          "value",
          "status",
          "source_ids",
          "confidence",
          "identity"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "status": {
            "enum": [
              "user-provided",
              "verified",
              "corroborated",
              "lead",
              "conflicting",
              "unavailable"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "object",
            "required": [
              "score",
              "explanation"
            ],
            "additionalProperties": false,
            "properties": {
              "score": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "explanation": {
                "type": "string"
              }
            }
          },
          "identity": {
            "enum": [
              "provided",
              "candidate",
              "anchored"
            ]
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "adapter",
          "url",
          "retrieved_at",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "adapter": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "retrieved_at": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "unavailable",
              "unsupported"
            ]
          },
          "detail": {
            "type": "string"
          },
          "cached": {
            "type": "boolean"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "finding_id",
          "source_id",
          "excerpt",
          "retrieved_at"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "finding_id": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          },
          "retrieved_at": {
            "type": "string"
          }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "relationship",
          "source_ids",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "relationship": {
            "type": "string"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "user-provided",
              "verified",
              "corroborated",
              "lead",
              "conflicting",
              "unavailable"
            ]
          }
        }
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "date",
          "source_ids",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "date": {
            "type": "object",
            "properties": {
              "start": {
                "type": "string"
              },
              "end": {
                "type": "string"
              },
              "precision": {
                "enum": [
                  "day",
                  "month",
                  "year",
                  "unknown"
                ]
              },
              "uncertain": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "user-provided",
              "verified",
              "corroborated",
              "lead",
              "conflicting",
              "unavailable"
            ]
          }
        }
      }
    },
    "plan": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    },
    "depth": {
      "enum": [
        "quick",
        "standard",
        "deep"
      ]
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "status",
        "sections",
        "limitations"
      ],
      "properties": {
        "model": {
          "type": "string"
        },
        "status": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sections": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "paragraphs": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 6000
                    },
                    "evidence_ids": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 200,
                      "uniqueItems": true,
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "text",
                    "evidence_ids"
                  ]
                }
              },
              "blocks": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "type": {
                          "const": "paragraph"
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 6000
                        },
                        "evidence_ids": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 200,
                          "uniqueItems": true,
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "required": [
                        "type",
                        "text",
                        "evidence_ids"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "type": {
                          "const": "quote"
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 6000
                        },
                        "evidence_ids": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 200,
                          "uniqueItems": true,
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "required": [
                        "type",
                        "text",
                        "evidence_ids"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "type": {
                          "const": "subheading"
                        },
                        "title": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        }
                      },
                      "required": [
                        "type",
                        "title"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "type": {
                          "const": "list"
                        },
                        "ordered": {
                          "type": "boolean"
                        },
                        "items": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 100,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "text": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 6000
                              },
                              "evidence_ids": {
                                "type": "array",
                                "minItems": 1,
                                "maxItems": 200,
                                "uniqueItems": true,
                                "items": {
                                  "type": "string"
                                }
                              }
                            },
                            "required": [
                              "text",
                              "evidence_ids"
                            ]
                          }
                        }
                      },
                      "required": [
                        "type",
                        "items"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "type": {
                          "const": "table"
                        },
                        "caption": {
                          "type": "string",
                          "maxLength": 500
                        },
                        "columns": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 12,
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          }
                        },
                        "rows": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 100,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "cells": {
                                "type": "array",
                                "minItems": 1,
                                "maxItems": 12,
                                "items": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 4000
                                }
                              },
                              "evidence_ids": {
                                "type": "array",
                                "minItems": 1,
                                "maxItems": 200,
                                "uniqueItems": true,
                                "items": {
                                  "type": "string"
                                }
                              }
                            },
                            "required": [
                              "cells",
                              "evidence_ids"
                            ]
                          }
                        }
                      },
                      "required": [
                        "type",
                        "columns",
                        "rows"
                      ]
                    }
                  ]
                }
              }
            },
            "required": [
              "title"
            ],
            "anyOf": [
              {
                "required": [
                  "paragraphs"
                ]
              },
              {
                "required": [
                  "blocks"
                ]
              }
            ]
          }
        },
        "provider": {
          "type": "string"
        }
      }
    },
    "research_timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at"
      ],
      "properties": {
        "started_at": {
          "type": "string"
        },
        "finished_at": {
          "type": "string"
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "usage": {
      "type": "object"
    },
    "portrait": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_url",
        "source_id",
        "original_url",
        "retrieved_at",
        "caption"
      ],
      "properties": {
        "data_url": {
          "type": "string",
          "maxLength": 1500000,
          "pattern": "^data:image/(png|jpeg|gif|webp);base64,[A-Za-z0-9+/=]+$"
        },
        "source_id": {
          "type": "string",
          "maxLength": 4096
        },
        "original_url": {
          "type": "string",
          "maxLength": 4096
        },
        "retrieved_at": {
          "type": "string",
          "maxLength": 4096
        },
        "caption": {
          "type": "string",
          "maxLength": 4096
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PH0MBER investigation output v1"
}
